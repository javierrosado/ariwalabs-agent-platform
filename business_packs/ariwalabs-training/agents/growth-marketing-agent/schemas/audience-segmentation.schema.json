{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audience-segmentation",
  "type": "object",
  "required": [
    "status",
    "summary",
    "segments",
    "facts",
    "assumptions",
    "risks",
    "missing_information",
    "approval_required",
    "approval_reason",
    "errors",
    "next_actions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_input",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audience_id",
          "priority",
          "needs",
          "rationale"
        ],
        "properties": {
          "audience_id": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "$ref": "#/$defs/string_list"
    },
    "assumptions": {
      "$ref": "#/$defs/string_list"
    },
    "risks": {
      "$ref": "#/$defs/string_list"
    },
    "missing_information": {
      "$ref": "#/$defs/string_list"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "next_actions": {
      "$ref": "#/$defs/string_list"
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "recoverable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
