{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "student-journey",
  "type": "object",
  "required": [
    "status",
    "summary",
    "journey_events",
    "facts",
    "assumptions",
    "risks",
    "missing_information",
    "approval_required",
    "approval_reason",
    "errors",
    "next_actions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_input",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "journey_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "person_id",
          "stage",
          "recommended_action",
          "requires_external_message"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "person_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "prospect",
              "student",
              "certified_student",
              "community_member",
              "ambassador"
            ]
          },
          "recommended_action": {
            "type": "string"
          },
          "requires_external_message": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "$ref": "#/$defs/string_list"
    },
    "assumptions": {
      "$ref": "#/$defs/string_list"
    },
    "risks": {
      "$ref": "#/$defs/string_list"
    },
    "missing_information": {
      "$ref": "#/$defs/string_list"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "next_actions": {
      "$ref": "#/$defs/string_list"
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "recoverable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
