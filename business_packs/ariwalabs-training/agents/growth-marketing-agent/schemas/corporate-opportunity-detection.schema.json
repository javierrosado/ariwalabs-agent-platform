{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corporate-opportunity-detection",
  "type": "object",
  "required": [
    "status",
    "summary",
    "opportunity_signal",
    "facts",
    "assumptions",
    "risks",
    "missing_information",
    "approval_required",
    "approval_reason",
    "errors",
    "next_actions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_input",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "opportunity_signal": {
      "type": "object",
      "required": [
        "opportunity_signal_id",
        "student_id",
        "organization_id",
        "signals",
        "evidence",
        "confidence",
        "contact_allowed",
        "approval_checkpoint"
      ],
      "properties": {
        "opportunity_signal_id": {
          "type": "string"
        },
        "student_id": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        },
        "signals": {
          "$ref": "#/$defs/string_list"
        },
        "evidence": {
          "$ref": "#/$defs/string_list"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "contact_allowed": {
          "type": "boolean",
          "const": false
        },
        "approval_checkpoint": {
          "type": "string",
          "const": "approve_opportunity_registration"
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "$ref": "#/$defs/string_list"
    },
    "assumptions": {
      "$ref": "#/$defs/string_list"
    },
    "risks": {
      "$ref": "#/$defs/string_list"
    },
    "missing_information": {
      "$ref": "#/$defs/string_list"
    },
    "approval_required": {
      "type": "boolean",
      "const": true
    },
    "approval_reason": {
      "type": "string"
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "next_actions": {
      "$ref": "#/$defs/string_list"
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "recoverable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
