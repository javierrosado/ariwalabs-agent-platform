{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AriwaLabsCoreApprovalRecord",
  "type": "object",
  "required": [
    "approval_id",
    "execution_id",
    "agent_id",
    "workflow_id",
    "checkpoint",
    "approver",
    "status",
    "created_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        null
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
