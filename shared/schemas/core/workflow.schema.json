{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AriwaLabsCoreWorkflowContract",
  "type": "object",
  "required": [
    "workflow"
  ],
  "properties": {
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "purpose": {
          "type": "string"
        },
        "restrictions": {
          "$ref": "#/$defs/string_list"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "step": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "parallel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "approval": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "foreach": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "skill"
          ]
        },
        {
          "required": [
            "parallel"
          ]
        },
        {
          "required": [
            "approval"
          ]
        },
        {
          "required": [
            "action"
          ]
        },
        {
          "required": [
            "workflow"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
